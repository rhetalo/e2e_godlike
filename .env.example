# Copy this file to .env and fill in your values
# Never commit .env to git
#
# ⚙️ .env АВТО-ЗАГРУЖАЕТСЯ (с 27-Jun-2026): playwright.config.ts делает `import 'dotenv/config'`.
#    dotenv НЕ перезаписывает уже заданные переменные → на CI/VPS реальные env-vars побеждают,
#    локально .env заполняет недостающее. У всех переменных есть рабочие дефолты в коде (utils/*),
#    поэтому .env нужен лишь чтобы ПЕРЕОПРЕДЕЛИТЬ их (другой аккаунт/сервер/секрет).

# ── VirtFusion panel (vf-panel.godlike.host) ─────────────────────────────────
# Используется в tests/vps/panel/* и utils/auth.ts
PANEL_EMAIL=test@testmail.com
PANEL_PASSWORD=your_panel_password_here

# ── Основной клиентский аккаунт godlike.host (clientarea) ────────────────────
# Аккаунт с активными сервисами — промокод НЕ срабатывает (для invalid promo тестов)
# Используется в fixtures/test-data.ts (Credentials), utils/clientareaAuth.ts и funnel-тестах.
CLIENTAREA_EMAIL=test@testmail.com
CLIENTAREA_PASSWORD=your_clientarea_password_here

# ── Свежий/free аккаунт godlike.host (clientarea) ────────────────────────────
# Аккаунт без активных подписок — промокод СРАБАТЫВАЕТ (для valid promo тестов)
# Используется в tests/modded/games.valid.promo.spec.ts
CLIENTAREA_FREE_EMAIL=testfree2@testmail.com
CLIENTAREA_FREE_PASSWORD=your_free_account_password_here

# ── Генерация тестовых пользователей (registration flow) ─────────────────────
# Пароль, используемый при авто-создании новых тестовых аккаунтов
TEST_USER_PASSWORD=Password_123

# ── Game panel (ultra.panel.godlike.host) ────────────────────────────────────
# Панель управления игровыми серверами (Minecraft). Используется в tests/game/panel/*
# и utils/gameAuth.ts. На этом аккаунте можно делать всё (старт/стоп/ребилд серверов).
GAME_PANEL_EMAIL=test@testmail.com
GAME_PANEL_PASSWORD=test@testmail.com
# ВАЖНО: серверы НЕ вечные (покупаются/удаляются). При смене сервера — поменяй UUID здесь.
# Идентичность сервера = UUID (он стабилен при переименовании). ИМЯ сервера НЕ задаём: тесты
# больше не пинят имя — где UI его требует, читают живьём со страницы (см. CODE_REVIEW ENV-001).
GAME_PANEL_SERVER_UUID=ebb03adc-48bf-46f1-95dd-a45d07f0d23d
# Выделенные серверы под изоляцию мутаций (дефолты — в utils/gameAuth.ts; задай тут лишь для override):
# GAME_PANEL_SERVER_POWER_UUID=f9793ddc-d9c9-4e9a-8d8c-911ebc462dc3   # power (test_e2e_power)
# GAME_PANEL_SERVER_BACKUP_UUID=00915cdc-37f5-41bb-8cae-74bb5e9f5d24  # backups (test_e2e_backup)
# GAME_PANEL_SERVER_FILE_UUID=ec78834c-2e09-430b-8428-d042cfc9605c    # files (test_e2e_file)
# GAME_PANEL_SERVER_CONSOLE_UUID=55ab39de-c80f-47c6-842c-aafd1a23dd90 # console (test_e2e_console)
# GAME_PANEL_SERVER_RENAME_UUID=e9440b5d-d77e-4dc6-b258-705e067ee5d2  # rename (test_e2e_rename)
# GAME_PANEL_STEAM_SERVER_UUID=cc25cea1                               # steam/ARK connection-info
# Второй аккаунт для тестов шеринга/ролей (Фаза 4). Приглашён на сервер выше.
GAME_PANEL_INVITEE_EMAIL=invitee@email.com
GAME_PANEL_INVITEE_PASSWORD=your_invitee_password_here

# ── Game panel — throttling webhook (ТОЛЬКО ручной запуск) ───────────────────
# ⚠ Успешный вызов сжигает 3-дневное антиспам-окно сервера. НЕ для CI.
# RUN_THROTTLING_TEST=1 разрешает запуск; без значения тест пропускается.
# GAME_PANEL_THROTTLE_SERVER_UUID — СВЕЖИЙ online Minecraft-сервер (не тот же,
#   что GAME_PANEL_SERVER_UUID, чтобы не мешать основным тестам).
# Запуск: RUN_THROTTLING_TEST=1 npx playwright test tests/game/panel/throttling.notification.spec.ts
RUN_THROTTLING_TEST=
GAME_PANEL_THROTTLE_SERVER_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Репортёры ─────────────────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL — Incoming Webhook URL. Без него репортёр молчит (не падает).
# В GitLab CI задаётся через Settings → CI/CD → Variables (masked).
# ⚠ Плейсхолдер с «...» конфиг трактует как пустой (иначе после dotenv стучался бы в фейк-URL).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# ── Опциональные переопределения (есть дефолты в коде) ───────────────────────
# PANEL_API_V2_BASE=https://panel.godlike.host/api/v2
